#!/bin/sh
# no suspend, power.nix forbids it. calc, emoji and kill have their own tabs.

ask() {
    setsid -f swaynag -t warning -m "$1?" -B "$1" "$2" >/dev/null 2>&1
}

case $1 in
    lock) setsid -f "$HOME/.config/sway/lock.sh" >/dev/null 2>&1 ;;
    logout) ask logout 'swaymsg exit' ;;
    reboot) ask reboot 'systemctl reboot' ;;
    poweroff) ask poweroff 'systemctl poweroff' ;;
    *) printf 'lock\0icon\037system-lock-screen\n'
       printf 'logout\0icon\037system-log-out\n'
       printf 'reboot\0icon\037system-reboot\n'
       printf 'poweroff\0icon\037system-shutdown\n' ;;
esac
